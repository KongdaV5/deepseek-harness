{
  "name": "@deepseek-ai/dsh-desktop-dev-composition",
  "description": "Explicit development-only composition of the DSH local-runtime capability packages",
  "version": "0.1.5-rc.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts", "cordis.patch.yml"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-run-policy": "workspace:^",
    "@deepseek-ai/dsh-agent-run-state": "workspace:^",
    "@deepseek-ai/dsh-agent-run-state-mlx": "workspace:^",
    "@deepseek-ai/dsh-client-desktop-run-diagnostics-remote": "workspace:^",
    "@deepseek-ai/dsh-client-ui-run-details": "workspace:^",
    "@deepseek-ai/dsh-compaction-basic": "workspace:^",
    "@deepseek-ai/dsh-desktop-run-diagnostics": "workspace:^",
    "@deepseek-ai/dsh-reasoning-policy": "workspace:^",
    "@deepseek-ai/dsh-task-checkpoint": "workspace:^"
  }
}
