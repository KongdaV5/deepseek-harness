{
  "name": "@deepseek-ai/dsh-desktop-custom",
  "description": "The DS Harness Desktop custom bundle: the tail patch layer over dsh-base and dsh-web-app that mounts the durable Task authority, the bounded run policy, the task-aware compaction policy, and the read-only Run Details transport and browser surface, and states the deployment's semantic-validation budget",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/desktop-custom"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-run-policy": "workspace:^",
    "@deepseek-ai/dsh-api-runtime-diagnostics-controller": "workspace:^",
    "@deepseek-ai/dsh-client-ui-run-details": "workspace:^",
    "@deepseek-ai/dsh-compaction-task-aware-policy": "workspace:^",
    "@deepseek-ai/dsh-run-details": "workspace:^",
    "@deepseek-ai/dsh-task-checkpoint": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "js-yaml": "^4.2.0"
  }
}
