{
  "name": "@deepseek-ai/dsh-desktop-run-diagnostics",
  "description": "Versioned read-only Desktop transport for local Agent Run diagnostics and explicit task resume",
  "version": "0.1.5-rc.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client.d.ts", "default": "./lib/client.js" },
    "./types": { "types": "./lib/types/types.d.ts", "default": "./lib/types/types.js" },
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/types/**/*.js", "lib/types/**/*.d.ts", "lib/typert.host.js", "lib/typert.host.d.ts", "lib/typert.remote-client.js", "lib/typert.remote-client.d.ts"],
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-agent-run-state": "workspace:^",
    "@deepseek-ai/dsh-reasoning-policy": "workspace:^",
    "@deepseek-ai/dsh-task-checkpoint": "workspace:^",
    "@deepseek-ai/dsh-typert-protocol": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-agent-run-state": "workspace:^",
    "@deepseek-ai/dsh-reasoning-policy": "workspace:^",
    "@deepseek-ai/dsh-task-checkpoint": "workspace:^",
    "@deepseek-ai/dsh-typert-protocol": "workspace:^",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  }
}
